node_modules/
dist/
.astro/
# Generated at build time, never committed: the gallery images, the app icon, and the favicon
# set come from scripts/assemble-gallery.mjs and generate-appindex.mjs, and webapp/ is the
# app's own web-dom build that CI unzips in. A committed webapp/ makes the
# deploy job's `unzip` prompt to overwrite and hang on EOF, which is how this rule got written.
public/gallery/
public/app/
public/_generated/
public/webapp/
# A second build channel's copies of all three, under its own segment (src/lib/channels.ts),
# plus the packages a development channel serves from the site itself.
public/main/
public/downloads/
# The sample's generated data (`npm run sample`), like an app repository's website/ pair, and the
# Day Showcase clone, export and screenshots it is generated from.
samples/appindex.json
samples/gallery-manifest.json
samples/.showcase/
