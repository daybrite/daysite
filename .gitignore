node_modules/
dist/
.astro/
# Generated at build time, never committed: the gallery images, the app icon, and the favicon
# set come from scripts/assemble-gallery.mjs and generate-appindex.mjs, and webapp/ is the
# app's own web-dom build that CI unzips in. A committed webapp/ makes the
# deploy job's `unzip` prompt to overwrite and hang on EOF, which is how this rule got written.
public/gallery/
public/app/
public/_generated/
public/webapp/
# The sample's generated data (`npm run sample`), like an app repository's website/ pair.
samples/appindex.json
samples/gallery-manifest.json
