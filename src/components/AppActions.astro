---
// The "get the app" actions for ONE platform, rendered inside that platform's About card: the Web
// tab offers "Open the web app", iOS/Android offer their localized store badge (or a sideload
// download when no store listing exists yet), and every other platform offers its primary package
// from the latest GitHub release (macOS → the .dmg, Windows → the .msix, …). The full artifact
// list stays on the DownloadCard above; this is the one-click story.
//
// Per-view, not per-site: the About card already sits inside its platform's
// `data-platform-section`, so the picker shows and hides these with everything else.
import type { ArtifactEntry, LocaleInfo, PlatformView, SiteInfo } from '../lib/types.ts';
import StoreBadge from './StoreBadge.astro';
import { dayTarget } from '../lib/day-targets.ts';
import { uiStrings } from '../lib/uistrings.ts';

interface Props {
  view: PlatformView;
  site: SiteInfo;
  locale: LocaleInfo;
}

const { view, site, locale } = Astro.props;
const ui = uiStrings(locale.code);
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const p = view.id;

// The store's badge (StoreBadge.astro), for the two platforms that have a store listing.
const badge =
  site.showStoreBadges !== false && view.storeURL
    ? p === 'ios'
      ? ('apple' as const)
      : p === 'android'
        ? ('google' as const)
        : undefined
    : undefined;

const webappHref = p === 'web' ? `${BASE}/${site.webapp ?? 'webapp'}/` : undefined;
// The app's full address, printed under the button so it can be read, copied, or typed on
// another device. Middle-truncated when the card is narrower than the URL: the head shrinks
// behind an ellipsis, the tail — where the path, the part that tells sites apart, ends — stays.
// `w-0 min-w-full` keeps the unbroken text out of the card's min-content width, so a narrow
// phone gets the ellipsis rather than a page that scrolls sideways.
const webappURL = webappHref ? new URL(webappHref, site.host).toString() : undefined;
const WEBAPP_TAIL = 14;
const webappParts = webappURL
  ? [webappURL.slice(0, -WEBAPP_TAIL), webappURL.slice(-WEBAPP_TAIL)]
  : undefined;

/** The one package this platform leads with, by the target's preference order (.msix before
 *  -setup.exe, .apk before .aab), falling back to whatever the release shipped first. */
function primary(): ArtifactEntry | undefined {
  if (!view.artifacts.length) return undefined;
  for (const suffix of dayTarget(p)?.packages ?? []) {
    const hit = view.artifacts.find((a) => a.name.endsWith(suffix));
    if (hit) return hit;
  }
  return view.artifacts[0];
}

// A store badge already IS the download button; showing both would offer the same app twice.
const dl = badge || p === 'web' ? undefined : primary();

function ext(name: string): string {
  const i = name.lastIndexOf('.');
  return i > 0 ? name.slice(i) : name;
}

const BUTTON =
  'inline-flex w-full items-center justify-center gap-2 rounded-full bg-[color:var(--color-accent)] px-5 py-2.5 font-semibold text-[color:var(--color-accent-fg)] shadow transition hover:opacity-90';
---

{(webappHref || badge || dl) && (
  <div class="flex flex-col items-center gap-3 pt-4 border-t border-[color:var(--color-border-soft)]" data-pagefind-ignore>
    {webappHref && (
      <a href={webappHref} class={BUTTON}>
        {ui.openWebApp}
        <span aria-hidden="true">&rarr;</span>
      </a>
    )}
    {webappHref && webappParts && (
      <a
        href={webappHref}
        title={webappURL}
        class="-mt-1 flex w-0 min-w-full justify-center font-mono text-xs text-[color:var(--color-text-soft)] transition hover:text-[color:var(--color-accent)]"
        dir="ltr"
      >
        <span class="min-w-0 overflow-hidden text-ellipsis whitespace-nowrap">{webappParts[0]}</span>
        <span class="shrink-0 whitespace-nowrap">{webappParts[1]}</span>
      </a>
    )}
    {badge && view.storeURL && (
      <StoreBadge store={badge} href={view.storeURL} locale={locale.code} height="3rem" heightSm="3.5rem" />
    )}
    {dl && (
      <a href={dl.url} download class={BUTTON} aria-label={`${ui.downloadHeading}: ${dl.name}`}>
        <span aria-hidden="true">&#x2913;</span>
        {ui.downloadHeading} {ext(dl.name)}
      </a>
    )}
  </div>
)}
