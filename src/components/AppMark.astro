---
// The landing page's app mark, and the hover treatment site.toml asks for.
//
// A Day SVG master marks its parts by id (day/docs/icons.md): `day:background` behind one or
// more `day:foreground…` layers, plus a `day:monochrome` silhouette that ships hidden for the
// platforms' tinted-icon modes. An effect moves those layers against each other, which needs
// the master IN the document — CSS cannot reach inside an `<img>`. `lib/data.ts` inlines it
// when the project ships one that marks layers; a raster-only icon, a flat drawing, or
// `icon-effect = "none"` renders the plain `<img>` and nothing moves.
import type { IconEffect } from '../lib/types.ts';

interface Props {
  /** The mark's URL, for the plain rendering. */
  src?: string;
  /** The SVG master's markup, when it can carry an effect. */
  markup?: string;
  effect: IconEffect;
  /** Alt text for the plain rendering; the inline mark is decorative beside the app's name. */
  alt?: string;
  /** Sizing and shape from the caller — the mark looks the same either way. */
  class?: string;
}

const { src, markup, effect, alt = '', class: className } = Astro.props;
const live = !!markup && effect !== 'none';
// bloom measures each shape, tilt follows the pointer, and emboss has to move a layer the
// master draws last; the other three are transitions on layers that are already in place.
const scripted = effect === 'bloom' || effect === 'tilt' || effect === 'emboss';
---

{live ? (
  <div class:list={['day-mark', className]} data-fx={effect} data-scripted={scripted ? '' : undefined}>
    <div class="day-mark-art" set:html={markup} />
    {effect === 'tilt' && <span class="day-mark-sheen" aria-hidden="true"></span>}
  </div>
) : (
  src && (
    <img
      src={src}
      alt={alt}
      width="160"
      height="160"
      class={className}
      loading="eager"
      decoding="async"
    />
  )
)}

{/* Global rather than scoped: the layers these select come from `set:html`, so Astro's scope
    attribute is never stamped on them. `.day-mark` keys every rule, so nothing escapes the
    mark. Layers are addressed by the master's own ids — `[id^="day:foreground"]` rather than
    `#day\:foreground`, because a master may carry `day:foreground-2` and a `day:foreground-glow`
    and every one of them belongs to the motif. */}
<style is:global>
  .day-mark {
    position: relative;
    display: block;
    overflow: hidden;
    /* The whole mark turns under `tilt`; the other effects leave it alone. */
    transition: transform 0.13s ease-out, box-shadow 0.3s ease;
  }
  .day-mark-art,
  .day-mark-art svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .day-mark [id="day:background"],
  .day-mark [id^="day:foreground"],
  .day-mark [id="day:monochrome"],
  .day-mark .day-shape {
    /* Percentages in a transform then resolve against the icon's own square, so one rule reads
       the same on a 1024-unit master and a 120-unit one. Filter lengths do not follow suit —
       those take `--u`, one percent of the view box, which the script publishes. */
    transform-box: view-box;
    transform-origin: center;
    transition:
      transform 0.45s cubic-bezier(0.22, 0.9, 0.3, 1),
      opacity 0.45s ease,
      filter 0.45s ease;
  }

  /* raise — the motif lifts and drops a shadow onto the backdrop, which dims and holds still.
     Scaling a full-bleed backdrop down would open a gap at the mark's rounded edge. */
  .day-mark[data-fx="raise"]:is(:hover, :focus-visible, [data-on]) [id^="day:foreground"] {
    transform: translateY(-3%) scale(1.07);
    filter: drop-shadow(0 calc(var(--u, 10) * 1.6px) calc(var(--u, 10) * 1.7px) rgba(0, 0, 0, 0.34));
  }
  .day-mark[data-fx="raise"]:is(:hover, :focus-visible, [data-on]) [id="day:background"] {
    filter: brightness(0.93) saturate(0.9);
  }

  /* tilt — the mark turns toward the pointer and the motif leads the backdrop into the turn. */
  .day-mark[data-fx="tilt"] {
    transform: perspective(560px) rotateX(calc(var(--ty, 0) * -9deg)) rotateY(calc(var(--tx, 0) * 9deg));
  }
  .day-mark[data-fx="tilt"] [id^="day:foreground"] {
    transform: translate(calc(var(--tx, 0) * var(--u, 10) * 2.6px), calc(var(--ty, 0) * var(--u, 10) * 2.6px));
    transition-duration: 0.13s;
  }
  .day-mark-sheen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    mix-blend-mode: soft-light;
    transition: opacity 0.3s ease;
    background: radial-gradient(
      60% 60% at var(--mx, 50%) var(--my, 50%),
      rgba(255, 255, 255, 0.42),
      rgba(255, 255, 255, 0) 65%
    );
  }
  .day-mark[data-fx="tilt"]:is(:hover, :focus-visible, [data-on]) .day-mark-sheen { opacity: 1; }

  /* bloom — each shape steps outward from the centre in turn; one at the centre stays put. */
  .day-mark .day-shape { transition-delay: calc(var(--i, 0) * 45ms); }
  .day-mark[data-fx="bloom"]:is(:hover, :focus-visible, [data-on]) .day-shape {
    transform: translate(calc(var(--dx, 0) * 1px), calc(var(--dy, 0) * 1px));
  }
  .day-mark[data-fx="bloom"]:is(:hover, :focus-visible, [data-on]) [id="day:background"] {
    filter: brightness(0.95);
  }

  /* emboss — the hidden monochrome silhouette, moved under the motif and shown as its shadow. */
  .day-mark[data-fx="emboss"] [id="day:monochrome"] { display: block; opacity: 0; }
  .day-mark[data-fx="emboss"]:is(:hover, :focus-visible, [data-on]) [id="day:monochrome"] {
    opacity: 0.34;
    transform: translate(2.2%, 3.4%);
    filter: blur(calc(var(--u, 10) * 0.32px));
  }
  .day-mark[data-fx="emboss"]:is(:hover, :focus-visible, [data-on]) [id^="day:foreground"] {
    transform: translateY(-1.6%) scale(1.03);
  }

  /* iris — the backdrop opens and brightens behind a motif that barely moves. */
  .day-mark[data-fx="iris"]:is(:hover, :focus-visible, [data-on]) [id="day:background"] {
    transform: scale(1.16);
    filter: brightness(1.1) saturate(1.25);
  }
  .day-mark[data-fx="iris"]:is(:hover, :focus-visible, [data-on]) [id^="day:foreground"] {
    transform: scale(0.985);
  }

  /* spin — a full turn, so the motif lands exactly where it started. A part-turn would only
     be right for a motif with matching symmetry, and most masters have none. */
  .day-mark[data-fx="spin"] [id^="day:foreground"] {
    transition-duration: 1.1s;
    transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }
  .day-mark[data-fx="spin"]:is(:hover, :focus-visible, [data-on]) [id^="day:foreground"] {
    transform: rotate(360deg);
  }

  /* Every effect is a change of state with travel between; without the travel the state change
     is still correct, so reduced motion keeps the effect and drops the animation. */
  @media (prefers-reduced-motion: reduce) {
    .day-mark,
    .day-mark [id="day:background"],
    .day-mark [id^="day:foreground"],
    .day-mark [id="day:monochrome"],
    .day-mark .day-shape,
    .day-mark-sheen {
      transition-duration: 1ms !important;
      transition-delay: 0ms !important;
    }
    .day-mark[data-fx="spin"] [id^="day:foreground"] { transition-property: none; }
  }
</style>

<script>
  // Publishes `--u` for every live mark, and does the DOM work three of the effects need. The
  // other three are pure CSS and this leaves them alone.
  for (const mark of document.querySelectorAll<HTMLElement>('.day-mark[data-fx]')) {
    const svg = mark.querySelector('svg');
    if (!svg) continue;
    const vb = svg.viewBox.baseVal;
    const size = vb.width || 100;
    // One percent of the view box, in user units. Transform percentages resolve against the
    // view box on their own; filter lengths are in user units, so a 1024-unit master and a
    // 120-unit one would read the same number as very different shadows.
    svg.style.setProperty('--u', (size / 100).toFixed(3));

    const fx = mark.dataset.fx;
    const foregrounds = Array.from(svg.querySelectorAll<SVGElement>('[id^="day:foreground"]'));

    // A tap has no hover, so it toggles `data-on` instead; a mark is not a control, so it takes
    // no focus of its own beyond what the effects already answer to.
    mark.addEventListener('click', () => mark.toggleAttribute('data-on'));
    mark.addEventListener('pointerleave', () => mark.removeAttribute('data-on'));

    if (fx === 'emboss') {
      // A master draws `day:monochrome` last, so as shipped it would cover the motif rather
      // than sit under it as its shadow.
      const mono = svg.querySelector('[id="day:monochrome"]');
      if (mono && foregrounds[0]) foregrounds[0].parentNode?.insertBefore(mono, foregrounds[0]);
    }

    if (fx === 'bloom') {
      const cx = vb.x + vb.width / 2;
      const cy = vb.y + vb.height / 2;
      const reach = size * 0.075;
      let i = 0;
      for (const layer of foregrounds) {
        for (const shape of Array.from(layer.children) as SVGGraphicsElement[]) {
          const box = shape.getBBox();
          const vx = box.x + box.width / 2 - cx;
          const vy = box.y + box.height / 2 - cy;
          const len = Math.hypot(vx, vy);
          // Each shape moves inside a wrapper of its own: a CSS transform REPLACES an element's
          // own `transform` attribute, and a generated motif places its shapes with `rotate(…)`
          // attributes that have to survive.
          const wrap = document.createElementNS('http://www.w3.org/2000/svg', 'g');
          wrap.setAttribute('class', 'day-shape');
          wrap.style.setProperty('--i', String(i++));
          if (len > 1) {
            wrap.style.setProperty('--dx', ((vx / len) * reach).toFixed(2));
            wrap.style.setProperty('--dy', ((vy / len) * reach).toFixed(2));
          }
          layer.insertBefore(wrap, shape);
          wrap.appendChild(shape);
        }
      }
    }

    if (fx === 'tilt' && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const sheen = mark.querySelector<HTMLElement>('.day-mark-sheen');
      mark.addEventListener('pointermove', (e) => {
        const r = mark.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        mark.style.setProperty('--tx', (x * 2 - 1).toFixed(3));
        mark.style.setProperty('--ty', (y * 2 - 1).toFixed(3));
        sheen?.style.setProperty('--mx', `${(x * 100).toFixed(1)}%`);
        sheen?.style.setProperty('--my', `${(y * 100).toFixed(1)}%`);
      });
      mark.addEventListener('pointerleave', () => {
        mark.style.removeProperty('--tx');
        mark.style.removeProperty('--ty');
      });
    }
  }
</script>
