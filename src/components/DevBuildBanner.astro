---
// The notice every development channel's page carries: these pages describe a build of a
// branch, it moves with each commit, and the released version is one link away. Shown above the
// hero so a visitor reads it before the download buttons, and on the gallery page for the same
// reason — those captures came from the same branch build.
import type { ChannelView } from '../lib/channels.ts';
import { uiStrings } from '../lib/uistrings.ts';

interface Props {
  channel: ChannelView;
  /** The release channel, when the repository has published one. */
  release?: ChannelView;
  /** That channel's page in this locale, for the call to action. */
  releaseHref?: string;
  locale: string;
}

const { channel, release, releaseHref, locale } = Astro.props;
const ui = uiStrings(locale);
const branch = channel.ref || channel.label;
const body = ui.devBuildBody.replace('[BRANCH]', branch);
const cta = release ? ui.devBuildReleaseLink.replace('[VERSION]', release.label) : undefined;
---

<aside class="dev-note flex items-start gap-3 rounded-2xl border px-4 py-3.5 sm:px-5" role="note" data-pagefind-ignore>
  <svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M10.3 3.9 2.5 17.4A1.9 1.9 0 0 0 4.2 20.3h15.6a1.9 1.9 0 0 0 1.7-2.9L13.7 3.9a1.9 1.9 0 0 0-3.4 0z" />
    <path d="M12 9.4v4.2" />
    <path d="M12 17h.01" />
  </svg>
  <div class="min-w-0 space-y-1">
    <p class="text-sm font-semibold">{ui.devBuildHeading}</p>
    <p class="text-sm">{body}</p>
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
      {cta && releaseHref ? (
        <a href={releaseHref} class="font-semibold underline underline-offset-2">{cta}</a>
      ) : (
        <span>{ui.devBuildNoRelease}</span>
      )}
      {channel.commit && (
        <span class="font-mono text-xs opacity-80">
          {channel.commitURL ? (
            <a href={channel.commitURL} target="_blank" rel="noopener" class="underline underline-offset-2">{channel.commit}</a>
          ) : (
            channel.commit
          )}
        </span>
      )}
    </p>
  </div>
</aside>

<style>
  /* An amber card of its own: the accent belongs to the app's brand, and a warning that borrows
     it stops reading as a warning. Both themes are spelled out because the site paints its own
     background — a transparent note would take the page's. */
  .dev-note {
    background: oklch(97% 0.045 85);
    border-color: oklch(86% 0.1 85);
    color: oklch(40% 0.1 68);
  }
  :global(html[data-theme='dark']) .dev-note {
    background: oklch(24% 0.05 78);
    border-color: oklch(40% 0.08 80);
    color: oklch(90% 0.07 88);
  }
</style>
