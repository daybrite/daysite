---
import type { HeroView } from '../lib/types.ts';

interface Props {
  hero: HeroView;
}

// The install actions live in the About card (AppActions), one platform at a time, so the hero is
// the app's identity and nothing else.
const { hero } = Astro.props;

---

<section class="relative">
  {hero.featureGraphicURL && (
    <div
      class="absolute inset-x-0 -top-8 sm:-top-12 -z-10 h-72 sm:h-96 overflow-hidden rounded-3xl opacity-50 blur-xl"
      aria-hidden="true"
      style={`background-image: url(${hero.featureGraphicURL}); background-size: cover; background-position: center;`}
    ></div>
  )}

  {/* A centered column, under the centered platform picker: with the install actions moved to the
      About card, the hero is only the app's identity, and a left-aligned title beneath a centered
      control reads as a misalignment rather than a layout. */}
  <div class="rise flex flex-col items-center gap-6 text-center sm:gap-8">
    {hero.iconURL && (
      <img
        src={hero.iconURL}
        alt=""
        width="160"
        height="160"
        class="size-28 sm:size-40 rounded-3xl shadow-2xl shadow-black/10 ring-1 ring-black/5 bg-white"
        loading="eager"
        decoding="async"
      />
    )}
    <div class="space-y-3 sm:space-y-4">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-balance">{hero.title}</h1>
      {hero.subtitle && (
        <p class="mx-auto max-w-2xl text-lg sm:text-xl text-[color:var(--color-text-soft)] text-pretty">{hero.subtitle}</p>
      )}
    </div>
  </div>
</section>
