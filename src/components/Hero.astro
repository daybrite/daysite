---
import type { HeroView, LocaleInfo, SiteInfo } from '../lib/types.ts';
import { badgeLocale } from '../lib/i18n.ts';

interface Props {
  hero: HeroView;
  site: SiteInfo;
  locale: LocaleInfo;
}

// The install actions live in the About card (AppActions), one platform at a time, so the hero is
// the app's identity — plus the store badges once the app is LISTED (Day.toml `[store]`): a live
// listing is the one fact about getting the app that belongs beside its name, whichever platform
// the picker shows. The badges are the stores' own localized artwork (public/badges/<locale>/).
const { hero, site, locale } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const badges =
  site.showStoreBadges === false
    ? []
    : hero.stores.map((s) =>
        s.store === 'apple-app-store'
          ? {
              url: s.url,
              src: `${BASE}/badges/${badgeLocale(locale.code, 'apple')}/apple-app-store.svg`,
              alt: 'Download on the App Store',
              // The App Store badge is drawn edge to edge; Google's carries its own margin, so
              // it takes a little more height for the two to read the same size side by side.
              size: 'h-10 sm:h-12',
            }
          : {
              url: s.url,
              src: `${BASE}/badges/${badgeLocale(locale.code, 'google')}/google-play-store.svg`,
              alt: 'Get it on Google Play',
              size: 'h-[3.1rem] sm:h-[3.6rem]',
            },
      );
---

<section class="relative">
  {hero.featureGraphicURL && (
    <div
      class="absolute inset-x-0 -top-8 sm:-top-12 -z-10 h-72 sm:h-96 overflow-hidden rounded-3xl opacity-50 blur-xl"
      aria-hidden="true"
      style={`background-image: url(${hero.featureGraphicURL}); background-size: cover; background-position: center;`}
    ></div>
  )}

  {/* The app mark at the leading edge, with the title and subtitle set against it. Both text
      lines share one starting edge with the icon, which is what makes the group read as a unit
      rather than as a centred stack that happens to have a picture on top.

      It stacks below `sm`, keeping the leading alignment: a 40-unit icon beside a wrapping title
      leaves the text about eleven characters wide on a phone. Above `sm` the text block centres
      against the icon, which is taller than two lines of it — top-aligned, the pair reads as a
      caption stranded at the top of a tall square. */}
  <div class="rise flex flex-col items-start gap-5 text-start sm:flex-row sm:items-center sm:gap-8">
    {hero.iconURL && (
      <img
        src={hero.iconURL}
        alt=""
        width="160"
        height="160"
        class="size-24 shrink-0 rounded-3xl bg-white shadow-2xl shadow-black/10 ring-1 ring-black/5 sm:size-32 lg:size-40"
        loading="eager"
        decoding="async"
      />
    )}
    <div class="space-y-3 sm:space-y-4">
      <h1 class="text-4xl font-bold tracking-tight text-balance sm:text-5xl">{hero.title}</h1>
      {hero.subtitle && (
        <p class="max-w-2xl text-lg text-[color:var(--color-text-soft)] text-pretty sm:text-xl">{hero.subtitle}</p>
      )}
      {badges.length > 0 && (
        <div class="flex flex-wrap items-center gap-3 pt-1" data-store-badges data-pagefind-ignore>
          {badges.map((b) => (
            <a
              href={b.url}
              class="inline-block rounded-lg transition hover:scale-[1.03] focus:outline-none focus:ring-2 focus:ring-[color:var(--color-accent)] focus:ring-offset-2 focus:ring-offset-[color:var(--color-bg)]"
              target="_blank"
              rel="noopener"
              aria-label={b.alt}
            >
              <img src={b.src} alt={b.alt} class={`w-auto ${b.size}`} loading="eager" decoding="async" />
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
