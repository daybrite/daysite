---
import type { AppView, LocaleInfo, PlatformView, SiteInfo } from '../lib/types.ts';
import { uiStrings } from '../lib/uistrings.ts';

import Hero from './Hero.astro';
import PlatformPicker from './PlatformPicker.astro';
import ScreenshotCarousel from './ScreenshotCarousel.astro';
import DescriptionBlock from './DescriptionBlock.astro';
import PermissionsList from './PermissionsList.astro';
import AboutCard from './AboutCard.astro';
import DownloadCard from './DownloadCard.astro';
import { galleryHref } from '../lib/routes.ts';

interface Props {
  site: SiteInfo;
  appView: AppView;
  locale: LocaleInfo;
  /** Whether the site has gallery data (adds the "see every platform" link). */
  hasGallery?: boolean;
}

const { site, appView, locale, hasGallery } = Astro.props;
const ui = uiStrings(locale.code);

const hero = appView.hero(locale.code);
const views: Partial<Record<string, PlatformView | null>> = Object.fromEntries(
  appView.platforms.map((p) => [p, appView.view(locale.code, p)]),
);
---

<div class="space-y-12 sm:space-y-16">
  <Hero hero={hero} />

  {/* The per-platform content is split around the picker: screenshots above it, everything that
      describes the app below. The picker hides and shows by `data-platform-section` across the
      WHOLE document, so both halves switch together and neither needs to know about the other. */}
  {appView.platforms.map((p) =>
    views[p] ? (
      <div data-platform-section={p} class="space-y-12 sm:space-y-16">
        <ScreenshotCarousel view={views[p]!} />
        {/* A compact link, not a card: the label alone carries it, and the platform picker now
            sits directly below — a full-width panel between the screenshots and the picker
            separated the two things a visitor is most likely to use in sequence. */}
        {hasGallery && site.showGallery !== false && (
          <div class="-mt-6 flex justify-center">
            <a
              href={galleryHref(locale.code)}
              class="group inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-sm font-medium text-[color:var(--color-accent)] no-underline transition hover:bg-[color:var(--color-accent-soft)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)]"
            >
              {/* Overlapping frames: the one shape that says "more screenshots" without a word
                  of copy, so it carries the meaning in every locale. */}
              <svg
                class="h-4 w-4 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="7.5" y="3.5" width="13" height="13" rx="2.5" />
                <path d="M16.5 20.5H6a2.5 2.5 0 0 1-2.5-2.5V7.5" />
                <path d="m10.5 12.5 2.5-2.5 3 3 1.5-1.5 3 3" />
              </svg>
              {ui.galleryLink}
              {/* rtl:-scale-x-100 so the arrow points AWAY from the text in Arabic too. */}
              <span
                class="shrink-0 transition-transform group-hover:translate-x-0.5 rtl:-scale-x-100"
                aria-hidden="true"
              >&rarr;</span>
            </a>
          </div>
        )}
      </div>
    ) : null,
  )}

  {/* Everything above answers for the platform chosen HERE, and everything below it does too —
      the picker sits between the screenshots and the description so the choice is visible at the
      moment the screenshots invite it, rather than announced above the title. */}
  {appView.platforms.length > 1 && (
    <div class="flex justify-center">
      <PlatformPicker
        platforms={appView.platforms}
        defaultPlatform={site.defaultPlatform}
        views={views}
      />
    </div>
  )}

  {appView.platforms.map((p) =>
    views[p] ? (
      <div data-platform-section={p} class="space-y-12 sm:space-y-16">
        <div class="grid gap-8 lg:gap-12 lg:grid-cols-[1fr_320px] items-start">
          <DescriptionBlock
            view={views[p]!}
            i18n={{
              aboutHeading: ui.about,
              releaseNotesHeading: ui.releaseNotes,
            }}
          />
          <div class="space-y-8">
          <AboutCard
            view={views[p]!}
            site={site}
            locale={locale}
            i18n={{
              aboutHeading: ui.about,
              versionLabel: ui.versionLabel,
              buildLabel: ui.buildLabel,
              bundleIdLabel: ui.bundleIdLabel,
              appIdLabel: ui.appIdLabel,
              privacyLink: ui.privacyLink,
              supportLink: ui.supportLink,
              dependenciesLabel: ui.dependenciesLabel,
            }}
          />
          <DownloadCard view={views[p]!} site={site} locale={locale} />
          </div>
        </div>

        {site.showPermissions !== false && (
          <PermissionsList
            view={views[p]!}
            i18n={{
              heading: ui.permissions,
              whyHeading: ui.whyNoDescription,
              rawKeyLabel: ui.rawKeyLabel,
              emptyText: ui.noPermissions,
            }}
          />
        )}
      </div>
    ) : null,
  )}
</div>
