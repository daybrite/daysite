---
import type { AppView, IconEffect, LocaleInfo, PlatformView, SiteInfo } from '../lib/types.ts';
import type { ChannelView } from '../lib/channels.ts';
import { stableChannel } from '../lib/channels.ts';
import { uiStrings } from '../lib/uistrings.ts';
import { localeIndexHref } from '../lib/routes.ts';

import Hero from '@daysite/components/Hero';
import ChannelPicker from '@daysite/components/ChannelPicker';
import ChannelNote from '@daysite/components/ChannelNote';
import WebAppCard from '@daysite/components/WebAppCard';
import PlatformPicker from '@daysite/components/PlatformPicker';
import PlatformShots from '@daysite/components/PlatformShots';
import DescriptionBlock from '@daysite/components/DescriptionBlock';
import PermissionsList from '@daysite/components/PermissionsList';
import AboutCard from '@daysite/components/AboutCard';
import DownloadCard from '@daysite/components/DownloadCard';

interface Props {
  site: SiteInfo;
  appView: AppView;
  locale: LocaleInfo;
  /** Whether the site has gallery data (adds the "see every platform" link). */
  hasGallery?: boolean;
  /** The build channel these pages describe, and every channel the site publishes. */
  channel?: ChannelView;
  channels?: ChannelView[];
  /** The app mark's hover treatment and the master that carries it (lib/data.ts). */
  iconEffect?: IconEffect;
  iconMarkup?: string;
}

const {
  site, appView, locale, hasGallery, channel, channels = [], iconEffect, iconMarkup,
} = Astro.props;
const ui = uiStrings(locale.code);
// The notice's call to action: the newest stable release, when there is one. A pre-release is
// not it, which is the whole point of the notice on the pre-release's own pages.
const releaseChannel = stableChannel(channels);
const channelHref = (c: ChannelView) => localeIndexHref(locale.code, c.path);
// The screenshots read best after the words that say what they show, so they sit under the
// description and the About card unless site.toml asks for them first (`screenshot-placement`).
const shotsAbove = site.screenshotPlacement === 'above-about';

const hero = appView.hero(locale.code);
const views: Partial<Record<string, PlatformView | null>> = Object.fromEntries(
  appView.platforms.map((p) => [p, appView.view(locale.code, p)]),
);
---

<div class="space-y-12 sm:space-y-16" data-platform-scope>
  <Hero hero={hero} iconEffect={iconEffect} iconMarkup={iconMarkup} />

  {/* The per-platform content is split around the picker. By default the screenshots go BELOW
      with the description; `screenshot-placement = "above-about"` puts them here instead, first
      after the hero. The picker hides and shows by `data-platform-section` across the WHOLE
      landing-page scope, so every half switches together and none needs to know about the others. */}
  {shotsAbove &&
    appView.platforms.map((p) =>
      views[p] ? (
        <div data-platform-section={p} class="space-y-12 sm:space-y-16">
          <PlatformShots view={views[p]!} site={site} locale={locale} hasGallery={hasGallery} channel={channel} />
        </div>
      ) : null,
    )}

  {/* Everything above answers for the platform chosen HERE, and everything below it does too —
      the picker sits between the screenshots and the description so the choice is visible at the
      moment the screenshots invite it, rather than announced above the title. The version picker
      stacks on top of it: which build, then which platform. */}
  {(channels.length > 1 || appView.platforms.length > 1) && (
    <div class="flex flex-col items-center gap-3">
      <ChannelPicker channels={channels} locale={locale.code} hrefFor={channelHref} />
      <ChannelNote channel={channel} release={releaseChannel} releaseHref={releaseChannel && channelHref(releaseChannel)} locale={locale.code} />
      {appView.platforms.length > 1 && (
        <PlatformPicker
          locale={locale.code}
          platforms={appView.platforms}
          defaultPlatform={site.defaultPlatform}
          views={views}
        />
      )}
    </div>
  )}

  {appView.platforms.map((p) =>
    views[p] ? (
      <div data-platform-section={p} class="space-y-12 sm:space-y-16">
        <div class="grid gap-8 lg:gap-12 lg:grid-cols-[1fr_320px] items-start">
          <DescriptionBlock
            view={views[p]!}
            i18n={{
              aboutHeading: ui.about,
              releaseNotesHeading: ui.releaseNotes,
            }}
          />
          <div class="space-y-8">
          <AboutCard
            view={views[p]!}
            site={site}
            locale={locale}
            channel={channel}
            i18n={{
              aboutHeading: ui.about,
              versionLabel: ui.versionLabel,
              buildLabel: ui.buildLabel,
              bundleIdLabel: ui.bundleIdLabel,
              appIdLabel: ui.appIdLabel,
              privacyLink: ui.privacyLink,
              supportLink: ui.supportLink,
              dependenciesLabel: ui.dependenciesLabel,
              commitLabel: ui.commitLabel,
            }}
          />
          <DownloadCard view={views[p]!} site={site} locale={locale} note={channel?.development ? ui.devBuildDownloadNote : undefined} />
          <WebAppCard view={views[p]!} site={site} locale={locale} channel={channel} />
          </div>
        </div>

        {!shotsAbove && (
          <PlatformShots view={views[p]!} site={site} locale={locale} hasGallery={hasGallery} channel={channel} />
        )}

        {site.showPermissions !== false && (
          <PermissionsList
            view={views[p]!}
            i18n={{
              heading: ui.permissions,
              whyHeading: ui.whyNoDescription,
              rawKeyLabel: ui.rawKeyLabel,
              emptyText: ui.noPermissions,
            }}
          />
        )}
      </div>
    ) : null,
  )}
</div>
