---
import type { AppView, LocaleInfo, PlatformView, SiteInfo } from '../lib/types.ts';
import { uiStrings } from '../lib/uistrings.ts';

import Hero from './Hero.astro';
import PlatformPicker from './PlatformPicker.astro';
import ScreenshotCarousel from './ScreenshotCarousel.astro';
import DescriptionBlock from './DescriptionBlock.astro';
import PermissionsList from './PermissionsList.astro';
import AboutCard from './AboutCard.astro';
import DownloadCard from './DownloadCard.astro';
import { galleryHref } from '../lib/routes.ts';

interface Props {
  site: SiteInfo;
  appView: AppView;
  locale: LocaleInfo;
  /** Whether the site has gallery data (adds the "see every platform" link). */
  hasGallery?: boolean;
}

const { site, appView, locale, hasGallery } = Astro.props;
const ui = uiStrings(locale.code);

const hero = appView.hero(locale.code);
const views: Partial<Record<string, PlatformView | null>> = Object.fromEntries(
  appView.platforms.map((p) => [p, appView.view(locale.code, p)]),
);
---

<div class="space-y-12 sm:space-y-16">
  {/* Above the title and directly under the site header: the platform is the first choice a
      visitor makes, and everything below it — screenshots, description, About, downloads —
      answers for the platform selected here. Pulled UP into <main>'s padding rather than down
      toward the hero, so it sits close to the header without crowding the title. */}
  {appView.platforms.length > 1 && (
    <div class="-mt-4 flex justify-center sm:-mt-8">
      <PlatformPicker
        platforms={appView.platforms}
        defaultPlatform={site.defaultPlatform}
        views={views}
      />
    </div>
  )}

  <Hero hero={hero} />

  {appView.platforms.map((p) =>
    views[p] ? (
      <div data-platform-section={p} class="space-y-12 sm:space-y-16">
        <ScreenshotCarousel view={views[p]!} />
        {/* The gallery is the most persuasive page on the site — the same app drawn by seven
            different native toolkits — and it used to be advertised by four words of small
            print under the carousel, which read as a footnote to the screenshots rather than
            an invitation past them. A card states what is on the other side and gives the
            link a real target: the whole panel is the hit area, not a 60px run of text. */}
        {hasGallery && site.showGallery !== false && (
          <div class="-mt-6 flex justify-center">
            <a
              href={galleryHref(locale.code)}
              class="group flex w-full max-w-xl items-center gap-4 rounded-2xl border border-[color:var(--color-accent-soft)] bg-[color:var(--color-accent-soft)] px-5 py-4 no-underline transition hover:border-[color:var(--color-accent)] hover:shadow-lg hover:shadow-black/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--color-accent)] sm:px-6"
            >
              {/* Overlapping frames: the one shape that says "more screenshots" without a word
                  of copy, so it carries the meaning in every locale. */}
              <svg
                class="h-8 w-8 shrink-0 text-[color:var(--color-accent)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="7.5" y="3.5" width="13" height="13" rx="2.5" />
                <path d="M16.5 20.5H6a2.5 2.5 0 0 1-2.5-2.5V7.5" />
                <path d="m10.5 12.5 2.5-2.5 3 3 1.5-1.5 3 3" />
              </svg>
              <span class="min-w-0 flex-1">
                <span class="block font-semibold text-[color:var(--color-text)]">{ui.galleryLink}</span>
                <span class="mt-0.5 block text-sm text-[color:var(--color-text-muted)]">{ui.galleryBlurb}</span>
              </span>
              {/* rtl:-scale-x-100 so the arrow points AWAY from the text in Arabic too. */}
              <span
                class="shrink-0 text-[color:var(--color-accent)] transition-transform group-hover:translate-x-0.5 rtl:-scale-x-100"
                aria-hidden="true"
              >&rarr;</span>
            </a>
          </div>
        )}

        <div class="grid gap-8 lg:gap-12 lg:grid-cols-[1fr_320px] items-start">
          <DescriptionBlock
            view={views[p]!}
            i18n={{
              aboutHeading: ui.about,
              releaseNotesHeading: ui.releaseNotes,
            }}
          />
          <div class="space-y-8">
          <AboutCard
            view={views[p]!}
            site={site}
            locale={locale}
            i18n={{
              aboutHeading: ui.about,
              versionLabel: ui.versionLabel,
              buildLabel: ui.buildLabel,
              bundleIdLabel: ui.bundleIdLabel,
              appIdLabel: ui.appIdLabel,
              privacyLink: ui.privacyLink,
              supportLink: ui.supportLink,
              dependenciesLabel: ui.dependenciesLabel,
            }}
          />
          <DownloadCard view={views[p]!} site={site} locale={locale} />
          </div>
        </div>

        {site.showPermissions !== false && (
          <PermissionsList
            view={views[p]!}
            i18n={{
              heading: ui.permissions,
              whyHeading: ui.whyNoDescription,
              rawKeyLabel: ui.rawKeyLabel,
              emptyText: ui.noPermissions,
            }}
          />
        )}
      </div>
    ) : null,
  )}
</div>
