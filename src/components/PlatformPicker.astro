---
import type { PlatformView } from '../lib/types.ts';
import { dayTarget } from '../lib/day-targets.ts';
import PlatformIcon from './PlatformIcon.astro';

interface Props {
  platforms: string[];
  defaultPlatform?: string;
  views: Partial<Record<string, PlatformView | null>>;
}

const { platforms, defaultPlatform, views } = Astro.props;
/**
 * The build-time selection, and the LAST resort at runtime: the client prefers the visitor's own
 * OS, then Web. `default-platform` in site.toml therefore only decides the no-JS rendering and
 * the case where the user agent names no OS the app ships and the app has no web build.
 */
const initial =
  defaultPlatform && platforms.includes(defaultPlatform) && views[defaultPlatform]
    ? defaultPlatform
    : (platforms.find((p) => views[p]) ?? platforms[0]);

/**
 * Which platform each browser-detectable OS should select, resolved HERE so the client script
 * needs no knowledge of the Day target vocabulary — it detects an OS name and looks it up.
 *
 * Only platforms this app actually ships appear, so a visitor on an OS the app skips falls
 * through to Web (and, failing that, to `initial`). Linux lists both desktop toolkits because a
 * user agent cannot say GNOME or KDE; whichever the app ships wins, GTK first.
 */
const OS_PLATFORMS: Record<string, string[]> = {
  harmony: ['harmony'],
  android: ['android'],
  ios: ['ios'],
  macos: ['macos'],
  windows: ['windows'],
  linux: ['linux-gtk', 'linux-qt'],
  web: ['web'],
};
const uaMap: Record<string, string> = {};
for (const [os, keys] of Object.entries(OS_PLATFORMS)) {
  for (const key of keys) {
    const hit = platforms.find((p) => dayTarget(p)?.key === key && views[p]);
    if (hit) {
      uaMap[os] = hit;
      break;
    }
  }
}
---

{platforms.length > 1 && (
  <div
    class="pf-picker flex max-w-full flex-nowrap snap-x items-center gap-0.5 overflow-x-auto rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-1 text-sm font-medium shadow-sm"
    role="tablist"
    aria-label="Choose platform"
    data-platform-picker
    data-initial={initial}
    data-ua-map={JSON.stringify(uaMap)}
    data-pagefind-ignore
  >
    {platforms.map((p) => (
      <button
        type="button"
        role="tab"
        aria-selected={p === initial ? 'true' : 'false'}
        data-platform-tab={p}
        class="inline-flex shrink-0 cursor-pointer snap-start items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-1.5 text-[color:var(--color-text-soft)] transition sm:px-3.5 ring-1 ring-inset ring-transparent hover:ring-[color:var(--color-border)] hover:text-[color:var(--color-text)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] aria-selected:bg-[color:var(--color-accent)] aria-selected:text-[color:var(--color-accent-fg)] aria-selected:shadow aria-selected:ring-transparent"
      >
        <span class="pf-tint" style={`--pf: var(--pf-${p}, currentColor)`} aria-hidden="true">
          <PlatformIcon id={dayTarget(p)?.icon ?? p} class="size-4" />
        </span>
        {dayTarget(p)?.name ?? p}
      </button>
    ))}
  </div>
)}

<script>
  const KEY = 'daysite-platform';

  /**
   * Bring the selected tab into view WITHIN the strip, by scrolling the strip itself.
   *
   * Not `scrollIntoView`: that walks every scrollable ancestor up to the document, so on a page
   * where the picker sits below the fold it scrolled the whole window down to reach the tab —
   * a page that jumped ~1800px the moment it loaded. `block: 'nearest'` does not prevent that;
   * it only means "scroll the least amount needed", and when the element is off-screen the least
   * amount is still a page scroll. Moving `scrollLeft` can only ever move this one element.
   */
  function revealTab(picker: HTMLElement, tab: HTMLElement) {
    const strip = picker.getBoundingClientRect();
    const box = tab.getBoundingClientRect();
    if (box.left < strip.left) picker.scrollLeft -= strip.left - box.left;
    else if (box.right > strip.right) picker.scrollLeft += box.right - strip.right;
  }

  /**
   * `anchor` keeps the picker under the pointer across the swap. The screenshot carousel above
   * the picker now shares one lane height across platforms (`--shot-h` in ScreenshotCarousel),
   * so a swap normally moves nothing and this measures zero; it stays as the guard for anything
   * above the picker that still sizes to its content, which used to slide the control the
   * visitor had just clicked ~1000px down a desktop viewport and ~1240px down a phone.
   * Re-scrolling by however far it moved puts it back. Off for the first apply: the visitor is
   * at the top of the page and nothing should scroll at all.
   */
  function applyPlatform(picker: HTMLElement, p: string, anchor = false) {
    const before = anchor ? picker.getBoundingClientRect().top : 0;
    for (const tab of picker.querySelectorAll<HTMLElement>('[data-platform-tab]')) {
      const on = tab.dataset.platformTab === p;
      tab.setAttribute('aria-selected', on ? 'true' : 'false');
      // The row scrolls on narrow screens, where the selected tab can sit outside the visible
      // strip — a segmented control whose current value is off-screen reads as having none.
      if (on) revealTab(picker, tab);
    }
    for (const section of document.querySelectorAll<HTMLElement>('[data-platform-section]')) {
      const wants = section.dataset.platformSection;
      section.classList.toggle('hidden', wants !== p);
    }
    if (anchor) {
      const moved = picker.getBoundingClientRect().top - before;
      if (moved) window.scrollBy(0, moved);
    }
    try { localStorage.setItem(KEY, p); } catch {}
  }

  /**
   * The visitor's OS, as one of the keys the server put in `data-ua-map`, or '' when the user
   * agent does not say. Order matters twice over: HarmonyOS and Android both claim "Android",
   * and every Android UA also contains "Linux".
   */
  function guessOs(): string {
    const ua = navigator.userAgent || '';
    if (/HarmonyOS|OpenHarmony/i.test(ua)) return 'harmony';
    if (/Android/i.test(ua)) return 'android';
    if (/iPhone|iPod/i.test(ua)) return 'ios';
    // iPadOS ships a desktop Safari UA claiming Macintosh; touch points are what separate a
    // real Mac from an iPad, and getting this wrong sends every iPad visitor to macOS.
    if (/iPad/i.test(ua)) return 'ios';
    if (/Mac/i.test(ua)) return navigator.maxTouchPoints > 1 ? 'ios' : 'macos';
    if (/Windows/i.test(ua)) return 'windows';
    // ChromeOS is deliberately absent: it is not a Linux-desktop target, so it falls to Web.
    if (/Linux|X11/i.test(ua) && !/CrOS/i.test(ua)) return 'linux';
    return '';
  }

  for (const picker of document.querySelectorAll<HTMLElement>('[data-platform-picker]')) {
    const has = (p: string) => Boolean(p && picker.querySelector(`[data-platform-tab="${p}"]`));
    let initial = picker.dataset.initial || '';
    // Open on the visitor's own OS, and on Web when the user agent identifies none the app
    // ships. Only if neither resolves does the build-time default stand.
    let uaMap: Record<string, string> = {};
    try {
      uaMap = JSON.parse(picker.dataset.uaMap || '{}');
    } catch {}
    const guess = uaMap[guessOs()] || uaMap.web || '';
    if (has(guess)) initial = guess;
    // A choice the visitor made themselves outranks both.
    try {
      const saved = localStorage.getItem(KEY);
      if (has(saved || '')) initial = saved!;
    } catch {}
    if (initial) applyPlatform(picker, initial);

    picker.addEventListener('click', (e) => {
      const tab = (e.target as HTMLElement).closest<HTMLElement>('[data-platform-tab]');
      if (!tab) return;
      const p = tab.dataset.platformTab!;
      applyPlatform(picker, p, true);
    });
  }

  // For documents with platform-only sections but no picker (single-platform apps),
  // ensure the only section is shown.
  if (!document.querySelector('[data-platform-picker]')) {
    const sections = document.querySelectorAll<HTMLElement>('[data-platform-section]');
    sections.forEach((s) => s.classList.remove('hidden'));
  }
</script>

<style>
  /* Each icon wears its platform's accent, except on the selected tab where the accent pill is
     the background and the platform color would fight it — there it inherits the pill's text. */
  .pf-tint { display: inline-flex; color: var(--pf); }
  [aria-selected='true'] .pf-tint { color: inherit; }

  /* The row scrolls instead of wrapping, at every width: a segmented control that wraps inside a
     rounded-full border stops reading as one control, and with eight targets it grows tall enough
     to crowd the title below. It shrinks to its content and centers when it fits, so scrolling
     only ever appears when it must. The scrollbar is hidden (the same treatment as .carousel) —
     momentum scroll, the snap points, and scrolling the selected tab into view do the work. */
  .pf-picker {
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .pf-picker::-webkit-scrollbar {
    display: none;
  }

  /* A pointing hand on the whole control, so the affordance does not depend on hitting the label. */
  .pf-picker,
  .pf-picker [data-platform-tab] {
    cursor: pointer;
  }
</style>
