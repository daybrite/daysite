---
import '../styles/global.css';
import type { FaviconPaths, LocaleInfo, LocaleLink, SiteInfo } from '../lib/types.ts';
import type { ChannelView } from '../lib/channels.ts';
import { pickText } from '../lib/i18n.ts';
import { localeIndexHref } from '../lib/routes.ts';
import { uiStrings } from '../lib/uistrings.ts';
import { svg as qrSvg } from '../lib/qr.mjs';
import { loadSite } from '../lib/data.ts';
import LanguagePicker from '../components/LanguagePicker.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchBar from '../components/SearchBar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  site: SiteInfo;
  /** All locales available on the site, with hrefs for the current page. */
  localeLinks: LocaleLink[];
  /** The locale this page is rendered in. */
  current: LocaleInfo;
  /**
   * Path of this page on the site, for the canonical URL. Defaults to the
   * locale's index path. Per-app pages pass /{locale}/apps/{slug}/.
   */
  pagePath?: string;
  pageTitle: string;
  pageDescription: string;
  socialImage?: string;
  favicons?: FaviconPaths;
  /**
   * URL of the app's SVG icon master. When present it becomes the primary favicon
   * (crisp at every size); the raster set stays for apple-touch / PWA slots and as
   * the fallback for browsers that don't take SVG favicons.
   */
  vectorIcon?: string;
  /** Optional links shown in the footer. */
  sourceURL?: string;
  releaseURL?: string;
  /**
   * If true, emit an inline script that reads `navigator.languages` and
   * redirects to the matching `/{locale}/` page. Only the bare `/` route
   * sets this to true; localized pages stay put so users can opt out of
   * auto-detection by navigating to /<their-locale>/ explicitly.
   */
  autoRedirect?: boolean;
  /**
   * The build channel this page belongs to (lib/channels.ts). It decides which staged web build
   * the page knows about and keeps the header's home link inside the channel, so a visitor on
   * `/en/main/gallery/` who clicks the title lands on `/en/main/`, not on the release.
   */
  channel?: ChannelView;
}

const {
  site,
  localeLinks,
  current,
  pagePath,
  pageTitle,
  pageDescription,
  socialImage,
  favicons,
  vectorIcon,
  sourceURL,
  releaseURL,
  autoRedirect = false,
  channel,
} = Astro.props;

// LocaleInfo.href is built without the deployed base prefix (i18n.ts can't
// safely read `import.meta.env.BASE_URL` because it's also imported from
// the Node-side astro.config.mjs). Use the base-aware route helper here.
const localeHomeHref = localeIndexHref(current.code, channel?.path);
const path = pagePath ?? localeHomeHref;
const canonical = new URL(path, site.host).toString();
const accent = site.accentColor ?? '#3B82F6';
// The app's own overrides (website/theme.css), inlined last so they win over the template —
// and whether this channel has a web build hosted, which decides if the page carries the site
// manifest.
const { themeCss, hasWebApp, channels } = await loadSite(channel?.id);
// Keep a development channel out of search results ONLY when a release channel is there to be
// found instead. A project before its first release publishes the branch build at the locale
// root, and noindexing that would hide the whole site.
const noindex = !!channel?.development && channels.some((c) => !c.development);

// Site title appears in the sticky top-bar and as a hreflang anchor; it's
// localized via pickText so siteinfo.yaml can carry either a plain string
// or a locale-keyed map.
const siteTitleText = pickText(site.title, current.code).value ?? '';

// The landing page's QR code: a toolbar icon that opens full screen, so the app can be handed
// to the phone next to you. The code carries the site's root URL, which sends a phone to its
// own language; the caption shows that URL so it can be read as well. Both renderings are
// inline SVG in `currentColor` with no plate of their own, so they follow the theme: dark
// modules on the light theme, light ones on the dark, the overlay's plate being the surface.
const ui = uiStrings(current.code);
const qrTitle = ui.qrTitle.replace('[APP]', siteTitleText || 'Day');
const qrURL = new URL(import.meta.env.BASE_URL, site.host).toString();
const showQr = site.showQrCode !== false;
const qrInline = { quiet: 0, color: 'currentColor', background: 'none' } as const;
const qrIcon = showQr ? qrSvg(qrURL, '', qrInline) : '';
const qrLarge = showQr ? qrSvg(qrURL, qrTitle, qrInline) : '';

// hreflang alternates per locale, page-specific href
const alternates = localeLinks.map((l) => ({
  hrefLang: l.code,
  href: new URL(l.href, site.host).toString(),
}));

// Astro normalizes BASE_URL to a trailing slash. Empty/'/' for root-deployed
// sites; '/Fair-Skies/' (etc.) for subpath/project-page deployments.
const baseURL = import.meta.env.BASE_URL;

// Payload for the auto-redirect script. The locales list is deliberately
// the whole-site set; the inline script needs to be parser-friendly. `base`
// is included so the redirect target stays under the deployed subpath.
const localeCodes = localeLinks.map((l) => l.code);
const redirectPayload = JSON.stringify({
  locales: localeCodes,
  defaultLocale: current.code,
  base: baseURL,
});

// Favicon paths are root-relative (`/app/…`); rebase them onto the deployed base so they
// resolve under subpath deployments too.
const faviconHref = (p: string) => baseURL + p.replace(/^\/+/, '');
---

<!doctype html>
<html
  lang={current.code}
  dir={current.rtl ? 'rtl' : 'ltr'}
  data-default-theme={site.defaultTheme ?? 'system'}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content={accent} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />

    {/* A development channel's pages describe a build that changes with every commit, and the
        release pages describe the same app. Letting both into an index would put "development
        build" results in front of people looking for the app, so only the release pages are
        indexed — they stay reachable through the version picker either way. */}
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* The SVG master first: browsers pick the sharpest declared icon, and a vector wins
        at every size. The PNG set remains for apple-touch / PWA slots and as the raster
        fallback — and the whole set for projects that ship no SVG master. */}
    {vectorIcon && <link rel="icon" type="image/svg+xml" href={vectorIcon} />}
    {favicons && (
      <>
        <link rel="icon" type="image/png" href={faviconHref(favicons.icon)} />
        <link rel="apple-touch-icon" href={faviconHref(favicons.appleTouchIcon)} />
        {favicons.pwaIcon192 && (
          <link rel="icon" sizes="192x192" href={faviconHref(favicons.pwaIcon192)} />
        )}
        <link rel="icon" sizes="512x512" href={faviconHref(favicons.pwaIcon512)} />
      </>
    )}

    {/* The site manifest (src/pages/site.webmanifest.ts): its start URL is the hosted web
        app, so adding THIS page to a home screen installs the app, icon and all. Only when a
        web build is staged — a manifest that starts nowhere would make the site itself the
        app — and only from the default channel, whose web build the manifest describes: a
        development channel's pages would otherwise install the released app under the name of
        the build they show. */}
    {hasWebApp && !channel?.path && <link rel="manifest" href={`${baseURL}site.webmanifest`} />}

    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.hrefLang} href={a.href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(baseURL, site.host).toString()}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <style is:global define:vars={{ accent }}>
      :root { --accent: var(--accent); }
    </style>
    <style is:global>
      /* The QR overlay: the gallery's viewer, reduced to one image and a caption. */
      .qr-box { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; }
      .qr-box[hidden] { display: none; }
      .qr-box:not([hidden]) { animation: qr-fade 0.18s ease; }
      @keyframes qr-fade { from { opacity: 0; } to { opacity: 1; } }
      .qr-backdrop { position: absolute; inset: 0; background: rgba(3, 6, 14, 0.86); backdrop-filter: blur(6px); }
      .qr-stage {
        position: relative; z-index: 1; margin: 0; padding: 0 16px;
        display: flex; flex-direction: column; align-items: center; gap: 18px;
        pointer-events: none;
      }
      /* The icon: the code alone, no quiet zone, sized to sit inside the round button with a
         ring of the button's own color around it. */
      .qr-icon svg { width: 1.2rem; height: 1.2rem; display: block; }
      /* The full-size code: the surface is the plate (white in light, near-black in dark, with
         the modules in the text color — an inverted code, which phone cameras read), and the
         padding is its quiet zone, four modules of a code this size. */
      .qr-img {
        width: min(78vw, 60vh, 480px); aspect-ratio: 1; box-sizing: border-box; padding: 6%;
        border-radius: 16px; background: var(--color-surface); color: var(--color-text);
        box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7);
      }
      .qr-img svg { width: 100%; height: 100%; display: block; }
      .qr-cap {
        display: flex; flex-direction: column; align-items: center; gap: 4px;
        text-align: center; color: #fff; max-width: min(92vw, 40rem);
      }
      .qr-cap b { font-weight: 600; }
      .qr-cap span { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85rem; opacity: 0.85; overflow-wrap: anywhere; }
      .qr-cap small { font-size: 0.8rem; opacity: 0.7; }
      .qr-close {
        position: absolute; z-index: 2; top: 18px; right: 18px; width: 42px; height: 42px;
        appearance: none; cursor: pointer; border: 1px solid var(--color-border); border-radius: 999px;
        background: color-mix(in srgb, var(--color-surface) 88%, transparent); color: var(--color-text);
        backdrop-filter: blur(8px); display: grid; place-items: center; font-size: 1.05rem;
      }
      .qr-close:hover { color: var(--color-accent); }
    </style>
    {themeCss && <style is:global set:html={themeCss}></style>}

    {site.analyticsScript && (
      <script
        is:inline
        defer
        src={site.analyticsScript}
        data-domain={site.analyticsDomain}
      ></script>
    )}

    {autoRedirect && (
      <script is:inline set:html={`
        (function () {
          try {
            var cfg = ${redirectPayload};
            var locales = cfg.locales || [];
            var nav = (typeof navigator !== 'undefined' && navigator) || {};
            var prefs = nav.languages && nav.languages.length
              ? nav.languages
              : [nav.language || ''];
            function pick(b) {
              if (!b) return null;
              var lc = String(b).toLowerCase();
              for (var i = 0; i < locales.length; i++) {
                if (String(locales[i]).toLowerCase() === lc) return locales[i];
              }
              var lang = lc.split('-')[0];
              for (var j = 0; j < locales.length; j++) {
                if (String(locales[j]).toLowerCase().split('-')[0] === lang) {
                  return locales[j];
                }
              }
              return null;
            }
            var target = null;
            for (var k = 0; k < prefs.length && !target; k++) {
              target = pick(prefs[k]);
            }
            if (target) {
              var loc = window.location;
              var base = cfg.base || '/';
              loc.replace(base + target + '/' + (loc.search || '') + (loc.hash || ''));
            }
          } catch (_) { /* never block rendering */ }
        })();
      `} />
    )}

    <script is:inline>
      (function () {
        try {
          var key = 'appland-theme';
          var saved = localStorage.getItem(key);
          var def = document.documentElement.getAttribute('data-default-theme') || 'system';
          var theme = saved || def;
          if (theme === 'system') {
            var mql = window.matchMedia('(prefers-color-scheme: dark)');
            theme = mql.matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-dvh text-[color:var(--color-text)]">
    <header
      class="sticky top-0 z-30 backdrop-blur-md bg-[color:var(--color-bg)]/70 border-b border-[color:var(--color-border-soft)]"
      data-pagefind-ignore
    >
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-3 flex items-center gap-3">
        <a
          href={localeHomeHref}
          class="font-semibold tracking-tight text-base sm:text-lg shrink-0"
        >{siteTitleText}</a>
        <div class="flex-1"></div>
        {site.pagefind && <SearchBar locale={current} />}
        {showQr && (
          <button
            type="button"
            data-qr-open
            aria-label={qrTitle}
            title={qrTitle}
            aria-haspopup="dialog"
            class="qr-icon inline-flex size-8 shrink-0 items-center justify-center rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] text-[color:var(--color-text)] transition hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)] focus:outline-none focus:ring-2 focus:ring-[color:var(--color-accent)]"
            set:html={qrIcon}
          />
        )}
        <LanguagePicker locales={localeLinks} current={current} />
        <ThemeToggle locale={current.code} />
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>

    {showQr && (
      <div class="qr-box" data-qr-box hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label={qrTitle}>
        <div class="qr-backdrop" data-qr-close></div>
        <button class="qr-close" data-qr-close type="button" aria-label={ui.closeDialog}>✕</button>
        <figure class="qr-stage">
          <div class="qr-img" set:html={qrLarge}></div>
          <figcaption class="qr-cap">
            <b>{qrTitle}</b>
            <span dir="ltr">{qrURL}</span>
            <small>{ui.qrHint}</small>
          </figcaption>
        </figure>
      </div>
    )}
    <Footer
      site={site}
      locale={current}
      sourceURL={sourceURL}
      releaseURL={releaseURL}
    />
    <script>
      // The QR overlay: open from the toolbar icon, close from the ✕, the backdrop, or Esc;
      // focus goes to the ✕ while it is up and back to the icon after.
      const qrBox = document.querySelector<HTMLElement>('[data-qr-box]');
      const qrOpen = document.querySelector<HTMLElement>('[data-qr-open]');
      if (qrBox && qrOpen) {
        const close = () => {
          qrBox.hidden = true;
          qrBox.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          qrOpen.focus();
        };
        qrOpen.addEventListener('click', () => {
          qrBox.hidden = false;
          qrBox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          qrBox.querySelector<HTMLElement>('.qr-close')?.focus();
        });
        for (const el of qrBox.querySelectorAll<HTMLElement>('[data-qr-close]')) el.addEventListener('click', close);
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !qrBox.hidden) close();
        });
      }
    </script>
  </body>
</html>
