---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import GalleryPage from '../../../components/GalleryPage.astro';
import { loadSite } from '../../../lib/data.ts';
import { uiStrings } from '../../../lib/uistrings.ts';
import { galleryHref, localeLinksFor } from '../../../lib/routes.ts';
import { galleryBlurb } from '../../../lib/gallery.ts';

// The default channel's gallery — the newest release's captures when the repository has one,
// otherwise the branch build's. Every other channel renders the same component under
// /{locale}/{channel}/gallery/ (lib/channels.ts). Pages exist only when the manifest holds
// captures.
export const getStaticPaths: GetStaticPaths = async () => {
  const data = await loadSite();
  if (!data.gallery) return [];
  return data.locales.map((l) => ({ params: { locale: l.code } }));
};

const { locale: localeParam } = Astro.params;
const data = await loadSite();
const locale = data.locales.find((l) => l.code === localeParam)!;
const ui = uiStrings(locale.code);
const appView = data.apps[0]!;
const hero = appView.hero(locale.code);
const blurb = galleryBlurb(ui.galleryBlurb);
---

<Layout
  site={data.site}
  localeLinks={localeLinksFor(data.locales, (c) => galleryHref(c, data.channel.path))}
  current={locale}
  pagePath={galleryHref(locale.code, data.channel.path)}
  pageTitle={`${ui.galleryHeading} – ${hero.title}`}
  pageDescription={blurb.text}
  socialImage={appView.socialImage ?? data.socialImage}
  favicons={data.favicons}
  vectorIcon={data.vectorIcon}
  sourceURL={appView.sourceURL}
  releaseURL={appView.releaseURL}
  channel={data.channel}
>
  <GalleryPage data={data} locale={locale} blurbHTML={blurb.html} />
</Layout>
