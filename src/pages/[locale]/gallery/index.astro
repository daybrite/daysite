---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import DeviceShell from '../../../components/DeviceShell.astro';
import PlatformIcon from '../../../components/PlatformIcon.astro';
import { loadSite } from '../../../lib/data.ts';
import { localizedText, shotLabel } from '../../../lib/gallery.ts';
import { dayTarget, DAY_TARGETS } from '../../../lib/day-targets.ts';
import { uiStrings } from '../../../lib/uistrings.ts';
import { galleryHref, localeLinksFor } from '../../../lib/routes.ts';
import '../../../styles/shells.css';

// One row per captured screen, every platform's capture side by side, dressed in its shell.
// Theme and locale switchers swap each image between its captured variants client-side; a
// combination that wasn't captured falls back (theme first, then locale, then anything) the
// way the daybrite.dev gallery does. Pages exist only when the manifest holds captures.
// Clicking a screenshot opens the full-size viewer below — the same 2-D navigator as
// daybrite.dev's gallery: ←/→ walk platforms across one screen, ↑/↓ walk screens on one
// platform.
export const getStaticPaths: GetStaticPaths = async () => {
  const data = await loadSite();
  if (!data.gallery) return [];
  return data.locales.map((l) => ({ params: { locale: l.code } }));
};

const { locale: localeParam } = Astro.params;
const data = await loadSite();
const gallery = data.gallery!;
const locale = data.locales.find((l) => l.code === localeParam)!;
const ui = uiStrings(locale.code);
const localeLinks = localeLinksFor(data.locales, galleryHref);
const appView = data.apps[0]!;
const hero = appView.hero(locale.code);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Platform column order: the curation's when site.toml pinned one (assemble-gallery carries it
// through the manifest), else the Day vocabulary's, for the targets that have captures.
const targetsPresent = new Set(gallery.shots.flatMap((s) => Object.keys(s.byPlatform)));
let columns: string[];
if (gallery.platforms?.length) {
  columns = gallery.platforms.filter((t) => targetsPresent.has(t));
} else {
  columns = DAY_TARGETS.filter((t) => targetsPresent.has(t.target)).map((t) => t.target);
  for (const t of targetsPresent) if (!columns.includes(t)) columns.push(t);
}

const phoneTargets = new Set(
  columns.filter((t) => dayTarget(t)?.device === 'phone'),
);

/** The row heading in THIS page's locale (falling back through the language, then English —
 *  `localizedText`), else derived from the capture's file name. */
const titleOf = (shot: (typeof gallery.shots)[number]) =>
  localizedText(shot.title, locale.code) ?? shotLabel(shot.id);
const captionOf = (shot: (typeof gallery.shots)[number]) =>
  localizedText(shot.caption, locale.code);

// The variant a (theme, locale) pair resolves to for a given platform's capture set — the same
// fallback ladder at build time (initial srcs) and in the switcher script below.
const showThemes = gallery.themes.filter((t) => t !== 'default');
const showLocales = gallery.locales.length > 1 ? gallery.locales : [];
function variantFor(caps: Record<string, unknown>, theme: string, loc: string): string {
  const order = [
    `${theme}-${loc}`,
    loc,
    theme,
    `${theme}-${gallery.locales[0]}`,
    'default',
    Object.keys(caps)[0]!,
  ];
  return order.find((v) => v in caps)!;
}
const initialTheme = showThemes[0] ?? 'default';
// The gallery page's own locale doubles as the preselected screenshot locale when captured.
const initialLocale = showLocales.includes(locale.code) ? locale.code : (gallery.locales[0] ?? 'default');
---

<Layout
  site={data.site}
  localeLinks={localeLinks}
  current={locale}
  pageTitle={`${ui.galleryHeading} – ${hero.title}`}
  pageDescription={ui.galleryBlurb}
  socialImage={appView.socialImage ?? data.socialImage}
  favicons={data.favicons}
  vectorIcon={data.vectorIcon}
  sourceURL={appView.sourceURL}
  releaseURL={appView.releaseURL}
>
  <div class="space-y-10">
    <header class="space-y-3 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{ui.galleryHeading}</h1>
      <p class="text-[color:var(--color-text-soft)]">{ui.galleryBlurb}</p>
      {(showThemes.length > 1 || showLocales.length > 1) && (
        <div class="flex flex-wrap items-center justify-center gap-3" data-gallery-switchers data-pagefind-ignore>
          {showThemes.length > 1 && (
            <div class="inline-flex rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-1 text-sm font-medium" role="radiogroup" data-seg="theme">
              {showThemes.map((t) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={t === initialTheme ? 'true' : 'false'}
                  data-value={t}
                  class="rounded-full px-3.5 py-1 transition aria-checked:bg-[color:var(--color-accent)] aria-checked:text-[color:var(--color-accent-fg)] text-[color:var(--color-text-soft)]"
                >{t === 'light' ? ui.themeLight : t === 'dark' ? ui.themeDark : t}</button>
              ))}
            </div>
          )}
          {showLocales.length > 1 && (
            <div class="inline-flex flex-wrap rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-1 text-sm font-medium" role="radiogroup" data-seg="slocale">
              {showLocales.map((l) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked={l === initialLocale ? 'true' : 'false'}
                  data-value={l}
                  class="rounded-full px-3.5 py-1 transition aria-checked:bg-[color:var(--color-accent)] aria-checked:text-[color:var(--color-accent-fg)] text-[color:var(--color-text-soft)]"
                >{l === 'default' ? data.defaultLocale : l}</button>
              ))}
            </div>
          )}
        </div>
      )}
    </header>

    {gallery.shots.map((shot, ri) => (
      <section class="space-y-3">
        <div class="flex items-baseline gap-3">
          <h2 class="text-lg font-semibold">{titleOf(shot)}</h2>
          {shot.source && appView.sourceURL && (
            <a
              class="gal-src"
              href={`${appView.sourceURL}/blob/main/${shot.source}`}
              target="_blank"
              rel="noopener"
              title={shot.source}
            >{shot.source.split('/').pop()}</a>
          )}
        </div>
        <div class="-mx-4 overflow-x-auto px-4 pb-2">
          <div class="flex items-stretch gap-5">
            {columns.map((target, ci) => {
              const caps = shot.byPlatform[target];
              if (!caps) return null;
              const day = dayTarget(target);
              const v = variantFor(caps, initialTheme, initialLocale);
              const cap = caps[v]!;
              const variantAttrs = Object.fromEntries(
                Object.entries(caps).map(([name, c]) => [`data-v-${name}`, `${base}/${c.src}`]),
              );
              return (
                <figure
                  class="w-[15rem] flex-none space-y-2"
                  class:list={[{ 'w-[24rem]': !phoneTargets.has(target) }]}
                  data-r={ri}
                  data-c={ci}
                  data-shot={titleOf(shot)}
                  data-caption={captionOf(shot)}
                  data-plat={target}
                  data-name={day?.displayName ?? target}
                >
                  <div class="gal-frame">
                    <DeviceShell
                      platform={target}
                      title={hero.title}
                      w={cap.width}
                      h={cap.height}
                    >
                      <img
                        src={`${base}/${cap.src}`}
                        alt={`${titleOf(shot)} — ${day?.displayName ?? target}`}
                        width={cap.width}
                        height={cap.height}
                        loading="lazy"
                        decoding="async"
                        class="gal-img"
                        {...variantAttrs}
                      />
                    </DeviceShell>
                  </div>
                  <figcaption class="flex items-center justify-center gap-1.5 text-xs text-[color:var(--color-text-soft)]">
                    <PlatformIcon id={day?.icon ?? target} class="size-3.5" />
                    {day?.displayName ?? target}
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </div>
      </section>
    ))}
  </div>

  {/* Full-size viewer, ported from daybrite.dev's gallery: navigation is 2-D and
      platform-aware — ←/→ cycle platforms across the SAME screen, ↑/↓ move to the
      previous/next screen on the SAME platform. Rows here can be sparse (a platform with no
      capture renders no tile), so every direction skips the holes. */}
  <div class="lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Screenshot viewer">
    <div class="lb-backdrop" data-lb-close></div>
    <button class="lb-btn lb-close" data-lb-close type="button" aria-label="Close (Esc)">✕</button>
    <button class="lb-btn lb-arrow lb-up" data-lb-dir="up" type="button" aria-label="Previous screen, same platform (↑)">↑</button>
    <button class="lb-btn lb-arrow lb-down" data-lb-dir="down" type="button" aria-label="Next screen, same platform (↓)">↓</button>
    <button class="lb-btn lb-arrow lb-left" data-lb-dir="left" type="button" aria-label="Previous platform (←)">‹</button>
    <button class="lb-btn lb-arrow lb-right" data-lb-dir="right" type="button" aria-label="Next platform (→)">›</button>
    <figure class="lb-stage">
      <img class="lb-img" data-lb-img alt="" hidden />
      <figcaption class="lb-cap">
        <span class="lb-shot" data-lb-shot></span>
        <span class="lb-plat"><i class="lb-icon" data-lb-icon aria-hidden="true"></i><b data-lb-name></b></span>
        <span class="lb-note" data-lb-note hidden></span>
      </figcaption>
    </figure>
  </div>
</Layout>

<style is:global>
  /* The row lane every tile shares. An explicit grid row (not just a height) so percentage
     heights resolve INSIDE the frame: `max-height: 100%` against an auto-height ancestor
     computes to none, and a 2600px-tall phone capture then blows straight through its bezel —
     the same trap day's own gallery documents on its `.frame` rule. `--shell-h` must be a
     LENGTH, not a percentage: shells.css derives a desktop window's width from
     calc((var(--shell-h) - bar) * aspect), and a % inside that calc would resolve against the
     containing block's WIDTH. */
  .gal-frame {
    --shell-h: 22rem;
    height: var(--shell-h);
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    justify-items: center;
    align-items: center;
    cursor: zoom-in;
  }
  /* Phones: pin the bezel to the lane so the capture's max-height has a definite base. */
  .gal-frame .sh-dev { height: 100%; }
  .gal-img { border-radius: 6px; }

  /* The row's source chip: the file the screen is rendered from, monospace like a path. */
  .gal-src {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.72rem;
    color: var(--color-text-soft);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 1px 9px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .gal-src::before { content: '</> '; opacity: 0.65; }
  .gal-src:hover { color: var(--color-text); border-color: var(--color-text-soft); }

  /* ---- Full-size viewer ---- */
  .lightbox { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; }
  .lightbox[hidden] { display: none; }
  .lightbox:not([hidden]) { animation: lb-fade 0.18s ease; }
  @keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
  .lb-backdrop { position: absolute; inset: 0; background: rgba(3, 6, 14, 0.86); backdrop-filter: blur(6px); }
  .lb-stage {
    position: absolute; inset: 0; z-index: 1; margin: 0;
    display: grid; place-items: center;
    pointer-events: none;
  }
  .lb-img {
    max-width: 92vw; max-height: 78vh; width: auto; height: auto; object-fit: contain;
    border-radius: 12px; background: var(--color-surface);
    box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7);
    animation: lb-pop 0.18s ease;
  }
  @keyframes lb-pop { from { transform: scale(0.985); opacity: 0.6; } to { transform: scale(1); opacity: 1; } }
  .lb-cap {
    position: absolute; left: 18px; top: 18px;
    z-index: 2; text-align: left;
    display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
    padding: 8px 16px; border-radius: 14px;
    background: color-mix(in srgb, var(--color-surface) 78%, transparent);
    backdrop-filter: blur(6px);
  }
  .lb-shot { color: var(--color-accent); font-weight: 700; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.1em; }
  .lb-plat { color: var(--color-text-soft); font-size: 0.98rem; display: inline-flex; align-items: center; gap: 8px; }
  .lb-plat b { color: var(--color-text); font-weight: 600; }
  .lb-note { color: var(--color-text-soft); font-size: 0.85rem; max-width: 34ch; }
  .lb-icon { display: inline-flex; }
  .lb-icon svg { width: 1.05rem; height: 1.05rem; }

  .lb-btn {
    position: absolute; z-index: 2; appearance: none; cursor: pointer;
    border: 1px solid var(--color-border); border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 88%, transparent); color: var(--color-text);
    backdrop-filter: blur(8px); display: grid; place-items: center;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .lb-btn:hover { color: var(--color-accent); }
  .lb-close { top: 18px; right: 18px; width: 42px; height: 42px; font-size: 1.05rem; }
  .lb-arrow { width: 52px; height: 52px; font-size: 1.7rem; line-height: 1; }
  .lb-left { left: 20px; top: 50%; transform: translateY(-50%); }
  .lb-right { right: 20px; top: 50%; transform: translateY(-50%); }
  .lb-up { top: 18px; left: 50%; transform: translateX(-50%); }
  .lb-down { bottom: 18px; left: 50%; transform: translateX(-50%); }
  @media (max-width: 620px) {
    .lb-arrow { width: 42px; height: 42px; font-size: 1.3rem; }
    .lb-left { left: 8px; } .lb-right { right: 8px; }
  }
</style>

<script>
  // Variant switching: every image carries data-v-<variant> URLs; the pickers re-resolve each
  // image with the same fallback ladder the build used for the initial state.
  const THEMES = ['light', 'dark'];
  const state = { theme: '', slocale: '' };
  const seg = (name: string) =>
    document.querySelector<HTMLElement>(`[data-seg="${name}"]`);
  for (const name of ['theme', 'slocale'] as const) {
    const el = seg(name);
    if (!el) continue;
    state[name] = el.querySelector<HTMLElement>('[aria-checked="true"]')?.dataset.value ?? '';
    el.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-value]');
      if (!btn) return;
      for (const b of el.querySelectorAll('[data-value]')) {
        b.setAttribute('aria-checked', b === btn ? 'true' : 'false');
      }
      state[name] = btn.dataset.value!;
      apply();
    });
  }

  function apply() {
    for (const img of document.querySelectorAll<HTMLImageElement>('.gal-img')) {
      const ladder = [
        `${state.theme}-${state.slocale}`,
        state.slocale,
        state.theme,
        'default',
      ];
      for (const want of ladder) {
        // dataset camelCases: data-v-light-fr → vLightFr. Match case-insensitively on the
        // normalized name instead of reconstructing the mangling.
        const key = Object.keys(img.dataset).find(
          (k) => k.toLowerCase() === `v${want.replace(/[^a-z0-9]/gi, '').toLowerCase()}`,
        );
        if (key && img.dataset[key]) {
          if (img.src !== img.dataset[key]) img.src = img.dataset[key]!;
          break;
        }
      }
    }
    // Desktop shells follow the site theme for their chrome palette.
    for (const win of document.querySelectorAll<HTMLElement>('.sh-win')) {
      if (THEMES.includes(state.theme)) win.toggleAttribute('data-dark', state.theme === 'dark');
    }
    // The open viewer follows a switcher change too: re-render picks up the tile's new src.
    render();
  }
  // The initial apply() runs at the END of this script: it reaches render(), whose lightbox
  // bindings are consts declared below — calling it here would hit their temporal dead zone.

  // ---- Full-size viewer: 2-D, platform-aware navigation ----
  //   ←/→  cycle platforms across the SAME screen (the tiles of one row)
  //   ↑/↓  move to the previous/next screen on the SAME platform (same column index)
  // Column index IS the platform (assigned from the shared column list at build time), but a
  // platform with no capture of a screen renders NO tile — the grid is sparse, so every
  // direction walks until it lands on a cell that exists.
  const box = document.querySelector<HTMLElement>('[data-lightbox]');
  const imgEl = box?.querySelector<HTMLImageElement>('[data-lb-img]');
  const shotEl = box?.querySelector<HTMLElement>('[data-lb-shot]');
  const nameEl = box?.querySelector<HTMLElement>('[data-lb-name]');
  const noteEl = box?.querySelector<HTMLElement>('[data-lb-note]');
  const lbIcon = box?.querySelector<HTMLElement>('[data-lb-icon]');

  // grid[row][col] = <figure>, sparse.
  const grid: HTMLElement[][] = [];
  let cols = 0;
  const figures = Array.from(document.querySelectorAll<HTMLElement>('figure[data-r]'));
  for (const fig of figures) {
    const r = Number(fig.dataset.r), c = Number(fig.dataset.c);
    (grid[r] ??= [])[c] = fig;
    cols = Math.max(cols, c + 1);
  }
  let cur: { r: number; c: number } | null = null;

  function render() {
    if (!cur || !box || !imgEl) return;
    const fig = grid[cur.r]?.[cur.c];
    if (!fig) return;
    const im = fig.querySelector<HTMLImageElement>('img.gal-img');
    if (!im) return;
    imgEl.src = im.currentSrc || im.src;
    imgEl.alt = im.alt;
    imgEl.hidden = false;
    if (shotEl) shotEl.textContent = fig.dataset.shot ?? '';
    if (nameEl) nameEl.textContent = fig.dataset.name ?? '';
    if (noteEl) {
      noteEl.textContent = fig.dataset.caption ?? '';
      noteEl.hidden = !fig.dataset.caption;
    }
    // Reuse the tile's own mark rather than shipping a second copy of every icon.
    if (lbIcon) lbIcon.innerHTML = fig.querySelector('figcaption svg')?.outerHTML ?? '';
  }

  function open(r: number, c: number) {
    if (!box) return;
    cur = { r, c };
    box.hidden = false;
    box.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    render();
    box.querySelector<HTMLElement>('.lb-close')?.focus();
  }
  function close() {
    if (!box) return;
    box.hidden = true;
    box.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    cur = null;
  }

  function navigate(dir: string) {
    if (!cur) return;
    if (dir === 'left' || dir === 'right') {
      let nc = cur.c;
      for (let i = 0; i < cols; i++) {
        nc = (nc + (dir === 'right' ? 1 : cols - 1)) % cols;
        if (grid[cur.r]?.[nc]) break;
      }
      cur.c = nc;
    } else {
      const n = grid.length;
      let nr = cur.r;
      for (let i = 0; i < n; i++) {
        nr = (nr + (dir === 'down' ? 1 : n - 1)) % n;
        if (grid[nr]?.[cur.c]) break;
      }
      cur.r = nr;
    }
    render();
  }

  // Open on click / Enter / Space of a tile's frame.
  for (const fig of figures) {
    const frame = fig.querySelector<HTMLElement>('.gal-frame');
    if (!frame || !fig.querySelector('img.gal-img')) continue;
    frame.setAttribute('role', 'button');
    frame.setAttribute('tabindex', '0');
    frame.setAttribute('aria-label', `${fig.dataset.shot} — ${fig.dataset.name}`);
    const go = () => open(Number(fig.dataset.r), Number(fig.dataset.c));
    frame.addEventListener('click', go);
    frame.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
    });
  }

  box?.querySelectorAll<HTMLElement>('[data-lb-dir]').forEach((btn) =>
    btn.addEventListener('click', () => navigate(btn.dataset.lbDir!)),
  );
  box?.querySelectorAll<HTMLElement>('[data-lb-close]').forEach((el) =>
    el.addEventListener('click', close),
  );

  document.addEventListener('keydown', (e) => {
    if (!box || box.hidden) return;
    const k = e.key;
    if (k === 'Escape') return close();
    const dir = { ArrowLeft: 'left', ArrowRight: 'right', ArrowUp: 'up', ArrowDown: 'down' }[k];
    if (dir) { e.preventDefault(); navigate(dir); }
  });

  apply();
</script>
